        <mxCell id="alt_box" value="&lt;b&gt;alt : Évolution du paiement&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F2F4F4;strokeColor=#7F8C8D;startSize=25;" parent="1" vertex="1">
