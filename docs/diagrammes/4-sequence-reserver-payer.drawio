          <mxGeometry x="570" y="80" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="ll_cmd" value="Commande&#10;[Agrégat]" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FADBD8;" parent="1" vertex="1">
          <mxGeometry x="710" y="80" width="100" height="750" as="geometry" />
