        </mxCell>
        <mxCell id="alt_cas1" value="&lt;b&gt;[Cas nominal : Paiement reçu dans les 10 min]&lt;/b&gt;&#10;PayVia -&gt; WebhookPayVia -&gt; ConfirmerPaiementService&#10;- seance.vendre(C-1, places, maintenant) [Places VENDUES]&#10;- commande.payer(maintenant) [Statut -&gt; PAYEE]&#10;- Enregistrement &amp; Publication de l événement CommandePayee" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#27AE60;align=left;" parent="alt_box" vertex="1">
          <mxGeometry x="60" y="460" width="1100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="alt_cas2" value="&lt;b&gt;[Cas expiration : Pas de paiement après 10 min]&lt;/b&gt;&#10;ExpirationPlanifiee (@Scheduled chaque minute) -&gt; ExpirerBlocagesService&#10;- seance.libererBlocagesExpires(maintenant) [Places remises à LIBRE]&#10;- commande.expirer(maintenant) [Statut -&gt; EXPIREE]&#10;- Enregistrement &amp; Publication de l événement CommandeExpiree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;align=left;" parent="alt_box" vertex="1">
